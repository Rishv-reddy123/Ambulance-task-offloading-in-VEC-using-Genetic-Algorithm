<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Define car vehicle type -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5"
           length="5" maxSpeed="13.9" color="0,0,1"/>

    <!-- Route loops near each hospital to simulate congestion -->
    <route id="hosmat_loop" edges="638531681#1 638531681#2 638531681#3 638531681#4 638531681#1"/>
    <route id="manipal_loop" edges="705674505#0 705674505#1 -705678828 705674505#0"/>
    <route id="bowring_loop" edges="48166762#0 48166762#1 48166762#2 48166762#0"/>
    <route id="stmarthas_loop" edges="727741259 -727741259 727741259"/>
    <route id="fortis_loop" edges="38772806#0 38772806#1 38772811#0 38772806#0"/>

    <!-- Vehicles around Hosmat -->
    <flow id="hosmat_flow" route="hosmat_loop" type="car"
          begin="0" end="200" vehsPerHour="500" departLane="random" departSpeed="random"/>

    <!-- Vehicles around Manipal -->
    <flow id="manipal_flow" route="manipal_loop" type="car"
          begin="0" end="200" vehsPerHour="400" departLane="random" departSpeed="random"/>

    <!-- Vehicles around Bowring -->
    <flow id="bowring_flow" route="bowring_loop" type="car"
          begin="0" end="200" vehsPerHour="450" departLane="random" departSpeed="random"/>

    <!-- Vehicles around St. Martha’s -->
    <flow id="stmarthas_flow" route="stmarthas_loop" type="car"
          begin="0" end="200" vehsPerHour="400" departLane="random" departSpeed="random"/>

    <!-- Vehicles around Fortis -->
    <flow id="fortis_flow" route="fortis_loop" type="car"
          begin="0" end="200" vehsPerHour="450" departLane="random" departSpeed="random"/>

</routes>
